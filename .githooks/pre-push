#!/bin/sh
current_branch=$(git symbolic-ref HEAD 2>/dev/null | sed -e 's,.*/\(.*\),\1,')

if [ "$current_branch" = "main" ] || [ "$current_branch" = "master" ]; then
  echo ""
  echo "❌ [BLOQUEADO] Está prohibido hacer 'git push' directo a la rama '$current_branch'."
  echo "👉 Por favor trabaja en tu rama asignada (feat/generative-tests o feat/api-traditional)"
  echo "   y sube tus cambios con: git push -u origin <tu-rama>"
  echo "   Luego abre un Pull Request en GitHub para que tu compañero lo apruebe."
  echo ""
  exit 1
fi

exit 0

